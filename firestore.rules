rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isValidator() {
      return hasRole('validator') || isAdmin();
    }

    // --- LESSONS ---
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isSignedIn() && (hasRole('contributor') || hasRole('educator') || isValidator());
    }

    // --- USER PROFILES & DATA ---
    match /users/{userId} {
      allow read: if true;
      // Users can only create their own profile; roles cannot be self-assigned
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'learner';
      // Hardened update rules: Users cannot change their own roles, XP, or crystals directly.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'xp', 'mistCrystals'])) ||
        isAdmin() ||
        (isValidator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp', 'mistCrystals', 'wordCount', 'voiceCount', 'lessonCount', 'status']))
      );
      allow delete: if isAdmin();

      match /progress/{lessonId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /bookmarks/{wordId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notifId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        // Allow any signed-in user to CREATE a notification for someone else (used for Cheers/Salutes)
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (request.auth.uid == userId || isValidator());
      }

      match /friends/{friendId} {
        allow read: if true;
        allow write: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == friendId);
      }

      match /friend_requests/{reqId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == reqId);
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == reqId);
      }

      match /achievements/{badgeId} {
        allow read: if true;
        allow write: if isSignedIn() && (request.auth.uid == userId || isValidator());
      }

      match /artifacts/{artifactId} {
        allow read: if true;
        allow write: if isSignedIn() && (request.auth.uid == userId || isValidator());
      }

      match /mastery/{wordId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /srs_progress/{wordId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /dailyQuests/{questId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- DICTIONARY (WORDS) ---
    match /words/{wordId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.contributorId == request.auth.uid || isValidator());
    }

    // --- CONTRIBUTOR REQUESTS ---
    match /contributor_requests/{requestId} {
      allow read: if isValidator();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    // --- LOCAL VOICES & SUBMISSIONS ---
    match /municipalities/{muniId} {
      allow read: if true;
      match /recordings/{recId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isValidator();
      }
    }

    match /voice_submissions/{submissionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isValidator();
    }

    // --- CONFIG & METADATA ---
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- TELEMETRY & ANALYTICS ---
    match /telemetry/{docId} {
      allow read: if isValidator();
      allow write: if isSignedIn();
      match /points/{pointId} {
        allow read: if isValidator();
        allow write: if isSignedIn();
      }
    }

    // --- COMMUNITY & SOCIAL ---
    match /community_feed/{activityId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- GLOBAL STATS ---
    match /global_stats/{docId} {
      allow read: if true;
      allow write: if isValidator();
    }

    // --- SCENARIOS ---
    match /scenarios/{scenarioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- COLLECTION GROUPS ---
    match /{path=**}/progress/{lessonId} {
      allow read: if isValidator() || hasRole('educator');
    }
  }
}
