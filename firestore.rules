rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isValidator() {
      return hasRole('validator') || isAdmin();
    }

    // --- LESSONS ---
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isSignedIn() && (hasRole('contributor') || hasRole('educator') || isValidator());
    }

    // --- USER PROFILES & DATA ---
    match /users/{userId} {
      allow read: if true;
      // Allow user to write their own, or validator to update XP/metadata during approval
      allow write: if isSignedIn() && (request.auth.uid == userId || isValidator());

      match /progress/{lessonId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /bookmarks/{wordId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notifId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        // Allow user to delete their own, or validator to create new ones (approval notifications)
        allow write: if isSignedIn() && (request.auth.uid == userId || isValidator());
      }

      match /achievements/{badgeId} {
        allow read: if true;
        allow write: if isSignedIn() && (request.auth.uid == userId || isValidator());
      }

      match /artifacts/{artifactId} {
        allow read: if true;
        allow write: if isSignedIn() && (request.auth.uid == userId || isValidator());
      }

      match /mastery/{wordId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /srs_progress/{wordId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /dailyQuests/{questId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- DICTIONARY (WORDS) ---
    match /words/{wordId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.contributorId == request.auth.uid || isValidator());
    }

    // --- CONTRIBUTOR REQUESTS ---
    match /contributor_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    // --- LOCAL VOICES ---
    match /municipalities/{muniId} {
      allow read: if true;
      match /recordings/{recId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isValidator();
      }
    }

    // --- GLOBAL STATS ---
    match /global_stats/{docId} {
      allow read: if true;
      allow write: if isValidator();
    }
  }
}
