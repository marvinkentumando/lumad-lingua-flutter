rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.keys().hasAny(['role']) && request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role)
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isEducator() {
      return hasRole('educator') || isAdmin();
    }

    // --- LESSONS ---
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isEducator();
    }

    // --- USER PROFILES & DATA ---
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isEducator()
      );
      allow delete: if isAdmin();

      match /progress/{lessonId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /lessonProgress/{progressId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /bookmarks/{wordId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notifId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (request.auth.uid == userId || isEducator());
      }

      match /friends/{friendId} {
        allow read: if true;
        allow write: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == friendId);
      }

      match /friend_requests/{reqId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == reqId);
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == reqId);
      }

      match /achievements/{badgeId} {
        allow read: if true;
        allow write: if isSignedIn() && (request.auth.uid == userId || isEducator());
      }

      match /artifacts/{artifactId} {
        allow read: if true;
        allow write: if isSignedIn() && (request.auth.uid == userId || isEducator());
      }

      match /mastery/{wordId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /mastery_history/{dateKey} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /duel_history/{historyId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /srs_progress/{wordId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /dailyQuests/{questId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- DICTIONARY & VOICE SUBMISSIONS ---
    match /words/{wordId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.contributorId == request.auth.uid || isEducator());
    }

    match /voice_submissions/{submissionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isEducator();
    }

    match /contributor_requests/{requestId} {
      allow read: if isEducator();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- LINGUA DUEL ---
    match /duel_matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.player1Id == request.auth.uid
        && request.resource.data.status == 'waiting';
      allow update: if isSignedIn() && (
        resource.data.player1Id == request.auth.uid ||
        resource.data.player2Id == request.auth.uid ||
        (resource.data.status == 'waiting' && request.resource.data.player2Id == request.auth.uid)
      );
      allow delete: if isSignedIn() && (
        resource.data.player1Id == request.auth.uid ||
        resource.data.player2Id == request.auth.uid
      );
    }

    match /lingua_duels/{duelId} {
      allow read: if isSignedIn();
      allow write: if isEducator();
    }

    // --- GAMIFICATION, SHOP & ARTIFACTS ---
    match /shop_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artifacts/{artifactId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- VILLAGE SANCTUARY & CLASSROOM ---
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isEducator();
    }

    match /village_mini_quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isEducator();
    }

    match /feedback/{feedbackId} {
      allow read: if isSignedIn() && (isEducator() || resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && isEducator();
      allow delete: if isAdmin();
    }

    // --- ASSESSMENTS & DAILY CHALLENGES ---
    match /assessments/{assessmentId} {
      allow read: if isEducator();
      allow create: if isSignedIn();
      allow update, delete: if isEducator();
    }

    match /daily_challenges/{dateId} {
      allow read: if isSignedIn();
      allow write: if isEducator();
    }

    // --- INVITATIONS & CONFIGS ---
    match /invitations/{inviteId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_configs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- AUDIT TRAIL & VERSION HISTORY ---
    match /audit_trail/{logId} {
      allow read: if isEducator();
      allow create: if isEducator();
    }

    match /{path=**}/version_history/{versionId} {
      allow read: if isEducator();
      allow create: if isEducator();
    }

    // --- TELEMETRY & ANALYTICS ---
    match /telemetry/{docId} {
      allow read: if isEducator();
      allow write: if isSignedIn();
      match /points/{pointId} {
        allow read: if isEducator();
        allow write: if isSignedIn();
      }
    }

    match /social_sentiment_data/{docId} {
      allow read: if true;
      allow write: if isEducator();
    }

    // --- COMMUNITY & SOCIAL ---
    match /community_feed/{activityId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- GLOBAL STATS & SCENARIOS ---
    match /global_stats/{docId} {
      allow read: if true;
      allow write: if isEducator();
    }

    match /scenarios/{scenarioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- COLLECTION GROUPS ---
    match /{path=**}/progress/{lessonId} {
      allow read: if isEducator();
    }

    match /{path=**}/srs_progress/{wordId} {
      allow read: if isEducator();
    }
  }
}
